{
    "manifest_version": 3,
    "name": "IC Helper",
    "version": "3.0.0",
    "description": "IC交易网助手（手动上报）",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "css": [
                "suspendedBall/content.css"
            ],
            "js": [
                "js/spiderApi.js",
                "js/poll.js",
                "js/getSuppliersProcessByJyw.js",
                "js/icCrmApiBackground.js",
                "content.js",
                "suspendedBall/content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "activeTab",
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "*://www.ic.net.cn/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "icons/icon48.png",
                "icons/get-task.png",
                "icons/report-task.png"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}