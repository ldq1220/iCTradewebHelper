{
    "manifest_version": 3,
    "name": "IC Helper",
    "version": "2.0.3",
    "description": "IC交易网助手(移动端)",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "64": "icons/icon64.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "IC交易网助手(移动端)"
    },
    "content_scripts": [
        {
            "matches": [
                "*://www.ic.net.cn/*",
                "*://member.ic.net.cn/*",
                "*://www.hqew.com/*",
                "*://s.hqew.com/*",
                "*://*.szlcsc.com/*",
                "*://m.ic.net.cn/*"
            ],
            "js": [
                "js/utils.js",
                "js/icCrmApiBackground.js",
                "js/spiderApi.js",
                "js/poll.js",
                "js/getSuppliersProcessByJyw.js",
                "js/getSuppliersProcessByHqw.js",
                "js/getSuppliersProcessByLcsc.js",
                "content.js"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "js/networkInterceptor.js"
            ],
            "matches": [
                "*://m.ic.net.cn/*"
            ]
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "activeTab",
        "tabs",
        "storage",
        "alarms",
        "webRequest",
        "declarativeNetRequest",
        "declarativeNetRequestFeedback"
    ],
    "host_permissions": [
        "*://www.ic.net.cn/*",
        "*://m.ic.net.cn/*",
        "*://max.ic.net.cn/*"
    ]
}